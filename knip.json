{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "ui": {
      "project": ["src/**/*.{ts,svelte}"],
      "entry": ["src/lib/protocol/*.ts", "src/test-runner.ts"]
    },
    "tests/e2e": {
      "entry": ["specs/**/*.ts", "ux/run.ts", "ux/alignment.ts"]
    },
    "tests/perf": {
      "entry": ["specs/**/*.ts"]
    },
    "site": {
      "entry": ["screenshots.ts"]
    },
    "tests/agents": {
      "entry": ["specs/**/*.ts", "recorder.ts"]
    }
  }
}
