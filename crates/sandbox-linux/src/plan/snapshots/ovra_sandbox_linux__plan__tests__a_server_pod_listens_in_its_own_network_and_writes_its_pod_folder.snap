ROOT/bin/ovra
--ovra-pod
ROOT/data/pods/p1
env HTTP_PROXY = Some("http://127.0.0.1:3128")
env HTTPS_PROXY = Some("http://127.0.0.1:3128")
env http_proxy = Some("http://127.0.0.1:3128")
env https_proxy = Some("http://127.0.0.1:3128")
env NO_PROXY = None
env no_proxy = None
env ALL_PROXY = None
env all_proxy = None
env NODE_USE_ENV_PROXY = Some("1")
env PATH = Some("/usr/bin")
env TMPDIR = Some("/tmp")
env GITHUB_TOKEN = None
env SSH_AUTH_SOCK = None
env CLAUDE_CODE_OAUTH_TOKEN = None
env CLAUDECODE = None
