---
source: crates/sandbox-linux/src/plan/tests.rs
expression: root.show(&line.unwrap())
---
--ovra-sandbox-outer
ROOT/data/sandbox-made/-ROOT-projects-app
--
/usr/bin/bwrap
--unshare-user
--unshare-pid
--unshare-ipc
--unshare-uts
--unshare-cgroup-try
--die-with-parent
--new-session
--cap-drop ALL
--unshare-net
--ro-bind /
--dev /dev
--proc /proc
--tmpfs /tmp
--tmpfs /var/tmp
--tmpfs /run
--tmpfs /mnt
--tmpfs /media
--tmpfs ROOT/home
--bind ROOT/data/pods/p1
--bind ROOT/projects/app
--ro-bind ROOT/projects/app/.claude
--ro-bind ROOT/projects/app/CLAUDE.md
--ro-bind ROOT/data/proxy/s.sock
--ro-bind ROOT/bin/ovra
--ro-bind ROOT/bin/ovra
--chdir ROOT/projects/app
--
ROOT/bin/ovra
--ovra-sandbox-helper
--landlock require
--rw /tmp
--rw /dev
--rw ROOT/home
--rw ROOT/data/pods/p1
--rw ROOT/projects/app
--bridge
ROOT/data/proxy/s.sock
3128
