---
source: crates/sandbox-linux/src/plan/tests.rs
expression: root.show(&line.unwrap())
---
--unshare-user
--unshare-pid
--unshare-ipc
--unshare-uts
--unshare-cgroup-try
--die-with-parent
--new-session
--cap-drop ALL
--unshare-net
--ro-bind /
--dev /dev
--proc /proc
--tmpfs /tmp
--tmpfs /run
--tmpfs ROOT/home
--tmpfs ROOT/data
--ro-bind ROOT/home/.claude
--tmpfs ROOT/home/.claude/backups
--tmpfs ROOT/home/.claude/cache
--tmpfs ROOT/home/.claude/debug
--tmpfs ROOT/home/.claude/file-history
--tmpfs ROOT/home/.claude/ide
--tmpfs ROOT/home/.claude/logs
--tmpfs ROOT/home/.claude/paste-cache
--tmpfs ROOT/home/.claude/plans
--tmpfs ROOT/home/.claude/session-env
--tmpfs ROOT/home/.claude/sessions
--tmpfs ROOT/home/.claude/shell-snapshots
--tmpfs ROOT/home/.claude/statsig
--tmpfs ROOT/home/.claude/telemetry
--tmpfs ROOT/home/.claude/todos
--bind ROOT/home/.claude/projects/-ROOT-data-worktrees-app-t-w1
--bind ROOT/home/.claude/history.jsonl
--ro-bind ROOT/projects/app/.git
--bind ROOT/projects/app/.git/worktrees/w1
--bind ROOT/data/worktrees/app/t/w1
--ro-bind ROOT/data/worktrees/app/t/w1/.git
--ro-bind ROOT/projects/app/.git/worktrees/w1/commondir
--ro-bind ROOT/projects/app/.git/worktrees/w1/config.worktree
--ro-bind ROOT/projects/app/.git/worktrees/w1/gitdir
--ro-bind ROOT/data/proxy/w1.sock
--ro-bind ROOT/bin/ovra
--ro-bind /usr/bin/dash
--chdir ROOT/data/worktrees/app/t/w1
--
ROOT/bin/ovra
--ovra-sandbox-helper
--landlock try
--rw /tmp
--rw /dev
--rw ROOT/home
--rw ROOT/home/.claude/backups
--rw ROOT/home/.claude/cache
--rw ROOT/home/.claude/debug
--rw ROOT/home/.claude/file-history
--rw ROOT/home/.claude/ide
--rw ROOT/home/.claude/logs
--rw ROOT/home/.claude/paste-cache
--rw ROOT/home/.claude/plans
--rw ROOT/home/.claude/session-env
--rw ROOT/home/.claude/sessions
--rw ROOT/home/.claude/shell-snapshots
--rw ROOT/home/.claude/statsig
--rw ROOT/home/.claude/telemetry
--rw ROOT/home/.claude/todos
--rw ROOT/home/.claude/projects/-ROOT-data-worktrees-app-t-w1
--rw ROOT/home/.claude/history.jsonl
--rw ROOT/projects/app/.git/worktrees/w1
--rw ROOT/data/worktrees/app/t/w1
--bridge
ROOT/data/proxy/w1.sock
3128
--
/usr/bin/dash
-p
env CLAUDECODE = None
env HTTP_PROXY = Some("http://127.0.0.1:3128")
env HTTPS_PROXY = Some("http://127.0.0.1:3128")
env http_proxy = Some("http://127.0.0.1:3128")
env https_proxy = Some("http://127.0.0.1:3128")
env NO_PROXY = None
env no_proxy = None
env ALL_PROXY = None
env all_proxy = None
env NODE_USE_ENV_PROXY = Some("1")
env PATH = Some("/usr/bin")
env TMPDIR = Some("/tmp")
