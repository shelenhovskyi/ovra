---
source: crates/fs-index/src/git.rs
expression: statuses
---
Statuses {
    paths: {
        "gone/x": (
            Deleted,
            None,
        ),
        "merge.txt": (
            Conflicted,
            None,
        ),
        "notes.md": (
            Untracked,
            None,
        ),
        "sub/a.txt": (
            Modified,
            None,
        ),
        "sub/fresh/": (
            Untracked,
            None,
        ),
        "sub/new file.txt": (
            Added,
            None,
        ),
        "sub/to.txt": (
            Renamed,
            Some(
                "sub/from.txt",
            ),
        ),
    },
    all_untracked: false,
}
