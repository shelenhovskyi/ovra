---
source: crates/fs-index/src/git.rs
expression: root
---
[
    (
        "gone",
        Child {
            status: Deleted,
            renamed_from: None,
            dir: true,
            deleted: true,
        },
    ),
    (
        "merge.txt",
        Child {
            status: Conflicted,
            renamed_from: None,
            dir: false,
            deleted: false,
        },
    ),
    (
        "notes.md",
        Child {
            status: Untracked,
            renamed_from: None,
            dir: false,
            deleted: false,
        },
    ),
    (
        "sub",
        Child {
            status: Modified,
            renamed_from: None,
            dir: true,
            deleted: false,
        },
    ),
]
