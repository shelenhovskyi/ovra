        ],
        "name": "Build box"
      }
    },
    {
      "method": "ssh.remove",
      "params": {
        "id": "h1"
      }
    },
    {
      "method": "ssh.rename",
      "params": {
        "id": "h1",
        "name": "Box"
      }
    }
  ],
  "responses": [
    {
      "data": [
        {
          "daemon": "ovra-daemon",
          "destination": "dev@build",
          "fingerprints": [
            "SHA256:abc"
          ],
          "id": "h1",
          "last_connected": 1,
          "name": "Build box"
        }
      ],
      "type": "ssh.hosts"
