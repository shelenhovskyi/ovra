---
source: crates/ssh/src/tests.rs
expression: "args.unwrap_or_else(|e| panic!(\"{e:?}\"))"
---
[
  "-T",
  "-x",
  "-a",
  "-o",
  "IgnoreUnknown=GSSAPIKeyExchange",
  "-o",
  "GSSAPIKeyExchange=no",
  "-o",
  "BatchMode=yes",
  "-o",
  "ConnectTimeout=20",
  "-o",
  "StrictHostKeyChecking=yes",
  "-o",
  "UpdateHostKeys=no",
  "-o",
  "HostKeyAlias=ovra-h1",
  "-o",
  "UserKnownHostsFile=\"/Users/me/Library/Application Support/ovra/ssh/h1/known_hosts\"",
  "-o",
  "GlobalKnownHostsFile=none",
  "-o",
  "KnownHostsCommand=none",
  "-o",
  "VerifyHostKeyDNS=no",
  "-o",
  "CheckHostIP=no",
  "-o",
  "ForwardAgent=no",
  "-o",
  "ForwardX11=no",
  "-o",
  "ForwardX11Trusted=no",
  "-o",
  "GSSAPIDelegateCredentials=no",
  "-o",
  "ClearAllForwardings=yes",
  "-o",
  "Tunnel=no",
  "-o",
  "PermitLocalCommand=no",
  "-o",
  "RemoteCommand=none",
  "-o",
  "RequestTTY=no",
  "-o",
  "SessionType=default",
  "-o",
  "StdinNull=no",
  "-o",
  "ForkAfterAuthentication=no",
  "-o",
  "EscapeChar=none",
  "-o",
  "ControlMaster=no",
  "-o",
  "ControlPath=none",
  "-o",
  "SetEnv=OVRA_UNUSED=1",
  "-o",
  "ServerAliveInterval=15",
  "-o",
  "ServerAliveCountMax=4",
  "--",
  "dev@build",
  "~/bin/ovra-daemon",
  "--stdio"
]
