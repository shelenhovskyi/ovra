      (regex #"^ROOT/[hH][oO][mM][eE]/[.][cC][oO][nN][fF][iI][gG]/[gG][hH](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/[kK][eE][yY][cC][hH][aA][iI][nN][sS](/.*)?$")
