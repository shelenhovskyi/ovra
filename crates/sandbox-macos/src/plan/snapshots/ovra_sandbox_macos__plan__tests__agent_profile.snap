      (regex #"^ROOT/[hH][oO][mM][eE]/[.][cC][aA][rR][gG][oO]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)[.][jJ](s|S|ſ)[oO][nN](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][lL][oO][cC][aA][lL]/(s|S|ſ)[hH][aA][rR][eE]/[cC][lL][aA][uU][dD][eE]/[vV][eE][rR](s|S|ſ)[iI][oO][nN](s|S|ſ)/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)(/.*)?$")
