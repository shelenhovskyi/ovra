      (subpath "ROOT/home/.claude/backups")
      (subpath "ROOT/home/.claude/cache")
      (subpath "ROOT/home/.claude/debug")
      (subpath "ROOT/home/.claude/file-history")
      (subpath "ROOT/home/.claude/ide")
      (subpath "ROOT/home/.claude/logs")
      (subpath "ROOT/home/.claude/paste-cache")
      (subpath "ROOT/home/.claude/plans")
      (subpath "ROOT/home/.claude/projects/-ROOT-projects-app")
