      (regex #"^ROOT/[hH][oO][mM][eE]/[.][cC][aA][rR][gG][oO]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS][.][tT][oO][mM][lL](/.*)?$")
