      (subpath "ROOT/home/.claude/statsig")
      (subpath "ROOT/home/.claude/todos")
      (subpath "ROOT/projects/app")
      (literal "ROOT/home/.gitconfig")
      (literal "ROOT/tmp/ca.pem")
      (literal "ROOT/home/.claude/history.jsonl"))
    (require-not (require-any
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][sS][sS][hH](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][aA][wW][sS](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][gG][nN][uU][pP][gG](/.*)?$")
