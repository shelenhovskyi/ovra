---
source: crates/sandbox-macos/src/plan/tests.rs
expression: root.profile_text(&plan)
---
(version 1)
(deny default)
(allow process-exec
  (require-not (regex #"/[gG][iI][tT]-[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]-[oO](s|S|ſ)[xX](k|K|K)[eE][yY][cC][hH][aA][iI][nN]$")))
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow sysctl-read)
(allow user-preference-read)
(allow ipc-posix-sem)
(allow ipc-posix-shm-read* (ipc-posix-name-prefix "apple.cfprefs."))
(allow pseudo-tty)
(allow file-read-metadata)
(allow file-map-executable)
(allow file-read* file-write*
  (literal "/dev/null")
  (literal "/dev/zero")
  (regex #"^/dev/fd/[0-9]+$"))
(allow file-read* file-write* file-ioctl
  (literal "/dev/ptmx")
  (literal "/dev/dtracehelper"))
(allow file-read* file-write* file-ioctl
  (require-all
    (regex #"^/dev/ttys[0-9]+$")
    (extension "com.apple.sandbox.pty")))
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.logd")
  (global-name "com.apple.cfprefsd.daemon")
  (global-name "com.apple.cfprefsd.agent")
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.trustd")
  (global-name "com.apple.trustd.agent")
  (global-name "com.apple.ocspd"))
(allow file-read*
  (require-all
    (require-any
      (require-not (require-any
      (regex #"^/[.][vV][oO][lL](/.*)?$")
      (regex #"^/(s|S|ſ)[yY](s|S|ſ)[tT][eE][mM]/[vV][oO][lL][uU][mM][eE](s|S|ſ)/[dD][aA][tT][aA](/.*)?$")
      (regex #"^/[vV][oO][lL][uU][mM][eE](s|S|ſ)(/.*)?$")
      (regex #"^/[pP][rR][iI][vV][aA][tT][eE]/[tT][mM][pP](/.*)?$")
      (regex #"^/[pP][rR][iI][vV][aA][tT][eE]/[vV][aA][rR]/[fF][oO][lL][dD][eE][rR](s|S|ſ)(/.*)?$")
      (regex #"^/[pP][rR][iI][vV][aA][tT][eE]/[vV][aA][rR]/[tT][mM][pP](/.*)?$")
      (regex #"^ROOT/[dD][aA][tT][aA](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE](/.*)?$")
      (regex #"^ROOT/[tT][mM][pP](/.*)?$")))
      (subpath "ROOT/home/.cargo")
      (subpath "ROOT/home/.claude")
      (subpath "ROOT/home/.local/share/claude/versions")
      (subpath "ROOT/home/.rustup")
      (subpath "ROOT/projects/main.git")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/cargo")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/npm")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/pip")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/pnpm")
      (subpath "ROOT/data/sandbox-temp/WORK-DIR-KEY")
      (subpath "ROOT/home/.claude/backups")
      (subpath "ROOT/home/.claude/cache")
      (subpath "ROOT/home/.claude/debug")
      (subpath "ROOT/home/.claude/file-history")
      (subpath "ROOT/home/.claude/ide")
      (subpath "ROOT/home/.claude/logs")
      (subpath "ROOT/home/.claude/paste-cache")
      (subpath "ROOT/home/.claude/plans")
      (subpath "ROOT/home/.claude/projects/-ROOT-projects-app")
      (subpath "ROOT/home/.claude/sessions")
      (subpath "ROOT/home/.claude/statsig")
      (subpath "ROOT/home/.claude/todos")
      (subpath "ROOT/projects/app")
      (literal "ROOT/home/.gitconfig")
      (literal "ROOT/tmp/ca.pem")
      (literal "ROOT/home/.claude/.credentials.json")
      (literal "ROOT/home/.claude/history.jsonl"))
    (require-not (require-any
      (regex #"^ROOT/[hH][oO][mM][eE]/[.](s|S|ſ)(s|S|ſ)[hH](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][aA][wW](s|S|ſ)(/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][gG][nN][uU][pP][gG](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][dD][oO][cC](k|K|K)[eE][rR](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.](k|K|K)[uU][bB][eE](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][nN][eE][tT][rR][cC](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][cC][oO][nN][fF][iI][gG]/[gG][hH](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/(k|K|K)[eE][yY][cC][hH][aA][iI][nN](s|S|ſ)(/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/[cC][oO][oO](k|K|K)[iI][eE](s|S|ſ)(/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/[mM][aA][iI][lL](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/[mM][eE](s|S|ſ)(s|S|ſ)[aA][gG][eE](s|S|ſ)(/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][rR][uU](s|S|ſ)[tT][uU][pP]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)(/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][rR][uU](s|S|ſ)[tT][uU][pP]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)[.][tT][oO][mM][lL](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][rR][uU](s|S|ſ)[tT][uU][pP]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)[.][jJ](s|S|ſ)[oO][nN](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][cC][aA][rR][gG][oO]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)(/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][cC][aA][rR][gG][oO]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)[.][tT][oO][mM][lL](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][cC][aA][rR][gG][oO]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)[.][jJ](s|S|ſ)[oO][nN](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][lL][oO][cC][aA][lL]/(s|S|ſ)[hH][aA][rR][eE]/[cC][lL][aA][uU][dD][eE]/[vV][eE][rR](s|S|ſ)[iI][oO][nN](s|S|ſ)/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)(/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][lL][oO][cC][aA][lL]/(s|S|ſ)[hH][aA][rR][eE]/[cC][lL][aA][uU][dD][eE]/[vV][eE][rR](s|S|ſ)[iI][oO][nN](s|S|ſ)/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)[.][tT][oO][mM][lL](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][lL][oO][cC][aA][lL]/(s|S|ſ)[hH][aA][rR][eE]/[cC][lL][aA][uU][dD][eE]/[vV][eE][rR](s|S|ſ)[iI][oO][nN](s|S|ſ)/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)[.][jJ](s|S|ſ)[oO][nN](/.*)?$")
      (regex #"/[gG][iI][tT]-[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]-[oO](s|S|ſ)[xX](k|K|K)[eE][yY][cC][hH][aA][iI][nN]$")))))
(allow file-write*
  (require-all
    (require-any
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/cargo")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/npm")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/pip")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/pnpm")
      (subpath "ROOT/data/sandbox-temp/WORK-DIR-KEY")
      (subpath "ROOT/home/.claude/backups")
      (subpath "ROOT/home/.claude/cache")
      (subpath "ROOT/home/.claude/debug")
      (subpath "ROOT/home/.claude/file-history")
      (subpath "ROOT/home/.claude/ide")
      (subpath "ROOT/home/.claude/logs")
      (subpath "ROOT/home/.claude/paste-cache")
      (subpath "ROOT/home/.claude/plans")
      (subpath "ROOT/home/.claude/projects/-ROOT-projects-app")
      (subpath "ROOT/home/.claude/sessions")
      (subpath "ROOT/home/.claude/statsig")
      (subpath "ROOT/home/.claude/todos")
      (subpath "ROOT/projects/app")
      (literal "ROOT/home/.claude/.credentials.json")
      (literal "ROOT/home/.claude/history.jsonl"))
    (require-not (require-any
      (regex #"^ROOT/[pP][rR][oO][jJ][eE][cC][tT](s|S|ſ)/[aA][pP][pP]/(.*/)?[.][gG][iI][tT](/.*)?$")
      (regex #"^ROOT/[pP][rR][oO][jJ][eE][cC][tT](s|S|ſ)/[aA][pP][pP]/[.][cC][lL][aA][uU][dD][eE](/.*)?$")
      (regex #"^ROOT/[pP][rR][oO][jJ][eE][cC][tT](s|S|ſ)/[aA][pP][pP]/[.][vV](s|S|ſ)[cC][oO][dD][eE](/.*)?$")
      (regex #"^ROOT/[pP][rR][oO][jJ][eE][cC][tT](s|S|ſ)/[aA][pP][pP]/(.*/)?[cC][lL][aA][uU][dD][eE][.][mM][dD](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][cC][lL][aA][uU][dD][eE]/[pP][rR][oO][jJ][eE][cC][tT](s|S|ſ)/-ROOT-[pP][rR][oO][jJ][eE][cC][tT](s|S|ſ)-[aA][pP][pP]/[mM][eE][mM][oO][rR][yY](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.](s|S|ſ)(s|S|ſ)[hH](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][aA][wW](s|S|ſ)(/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][gG][nN][uU][pP][gG](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][dD][oO][cC](k|K|K)[eE][rR](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.](k|K|K)[uU][bB][eE](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][nN][eE][tT][rR][cC](/.*)?$")
