      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/[kK][eE][yY][cC][hH][aA][iI][nN][sS](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/[cC][oO][oO][kK][iI][eE][sS](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/[mM][aA][iI][lL](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/[mM][eE][sS][sS][aA][gG][eE][sS](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][rR][uU][sS][tT][uU][pP]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS](/.*)?$")
