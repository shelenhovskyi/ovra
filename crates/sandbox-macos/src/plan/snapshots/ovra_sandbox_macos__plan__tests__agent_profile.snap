      (regex #"^ROOT/[hH][oO][mM][eE]/[.][lL][oO][cC][aA][lL]/[sS][hH][aA][rR][eE]/[cC][lL][aA][uU][dD][eE]/[vV][eE][rR][sS][iI][oO][nN][sS]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][lL][oO][cC][aA][lL]/[sS][hH][aA][rR][eE]/[cC][lL][aA][uU][dD][eE]/[vV][eE][rR][sS][iI][oO][nN][sS]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS][.][tT][oO][mM][lL](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][lL][oO][cC][aA][lL]/[sS][hH][aA][rR][eE]/[cC][lL][aA][uU][dD][eE]/[vV][eE][rR][sS][iI][oO][nN][sS]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS][.][jJ][sS][oO][nN](/.*)?$")))))
(allow file-write*
  (require-all
    (require-any
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/cargo")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/npm")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/pip")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/pnpm")
