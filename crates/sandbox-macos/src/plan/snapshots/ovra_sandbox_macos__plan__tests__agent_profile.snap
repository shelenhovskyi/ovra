      (regex #"^ROOT/[hH][oO][mM][eE]/[.][rR][uU][sS][tT][uU][pP]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS][.][jJ][sS][oO][nN](/.*)?$")
