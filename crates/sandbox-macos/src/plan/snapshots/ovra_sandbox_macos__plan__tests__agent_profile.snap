      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/(k|K|K)[eE][yY][cC][hH][aA][iI][nN](s|S|ſ)(/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/[cC][oO][oO](k|K|K)[iI][eE](s|S|ſ)(/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/[mM][aA][iI][lL](/.*)?$")
