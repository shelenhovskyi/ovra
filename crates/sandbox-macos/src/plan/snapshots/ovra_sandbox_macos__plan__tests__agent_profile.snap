      (regex #"^ROOT/[hH][oO][mM][eE]/[.][rR][uU](s|S|ſ)[tT][uU][pP]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)[.][tT][oO][mM][lL](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][rR][uU](s|S|ſ)[tT][uU][pP]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)[.][jJ](s|S|ſ)[oO][nN](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE]/[.][cC][aA][rR][gG][oO]/(.*/)?[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL](s|S|ſ)(/.*)?$")
