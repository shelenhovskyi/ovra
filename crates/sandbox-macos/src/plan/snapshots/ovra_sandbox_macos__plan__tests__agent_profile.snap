---
source: crates/sandbox-macos/src/plan/tests.rs
expression: root.profile_text(&plan)
---
(version 1)
(deny default)
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow sysctl-read)
(allow user-preference-read)
(allow ipc-posix-sem)
(allow ipc-posix-shm-read* (ipc-posix-name-prefix "apple.cfprefs."))
(allow pseudo-tty)
(allow file-read-metadata)
(allow file-map-executable)
(allow file-read* file-write* file-ioctl
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/tty")
  (literal "/dev/ptmx")
  (literal "/dev/dtracehelper")
  (regex #"^/dev/ttys[0-9]+$")
  (regex #"^/dev/fd/[0-9]+$"))
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.logd")
  (global-name "com.apple.cfprefsd.daemon")
  (global-name "com.apple.cfprefsd.agent")
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.trustd")
  (global-name "com.apple.trustd.agent")
  (global-name "com.apple.ocspd"))
(allow file-read*
  (require-all
    (require-any
      (require-not (require-any
      (regex #"^/[sS][yY][sS][tT][eE][mM]/[vV][oO][lL][uU][mM][eE][sS]/[dD][aA][tT][aA](/.*)?$")
      (regex #"^/[vV][oO][lL][uU][mM][eE][sS](/.*)?$")
      (regex #"^/[pP][rR][iI][vV][aA][tT][eE]/[tT][mM][pP](/.*)?$")
      (regex #"^/[pP][rR][iI][vV][aA][tT][eE]/[vV][aA][rR]/[fF][oO][lL][dD][eE][rR][sS](/.*)?$")
      (regex #"^/[pP][rR][iI][vV][aA][tT][eE]/[vV][aA][rR]/[tT][mM][pP](/.*)?$")
      (regex #"^ROOT/[dD][aA][tT][aA](/.*)?$")
      (regex #"^ROOT/[hH][oO][mM][eE](/.*)?$")
      (regex #"^ROOT/[tT][mM][pP](/.*)?$")))
      (subpath "ROOT/home/.cargo")
      (subpath "ROOT/home/.claude")
      (subpath "ROOT/home/.local/share/claude/versions")
      (subpath "ROOT/home/.rustup")
      (subpath "ROOT/projects/main.git")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/cargo")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/npm")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/pip")
      (subpath "ROOT/data/sandbox-caches/p-f5f849dca255a577b897e3534bd4462d/pnpm")
      (subpath "ROOT/data/sandbox-temp/p-f5f849dca255a577b897e3534bd4462d")
      (subpath "ROOT/home/.claude/backups")
      (subpath "ROOT/home/.claude/cache")
      (subpath "ROOT/home/.claude/debug")
      (subpath "ROOT/home/.claude/file-history")
      (subpath "ROOT/home/.claude/ide")
      (subpath "ROOT/home/.claude/logs")
      (subpath "ROOT/home/.claude/paste-cache")
      (subpath "ROOT/home/.claude/plans")
      (subpath "ROOT/home/.claude/projects/-ROOT-projects-app")
