      (regex #"^ROOT/[hH][oO][mM][eE]/[.][cC][lL][aA][uU][dD][eE]/[pP][rR][oO][jJ][eE][cC][tT][sS]/-ROOT-[pP][rR][oO][jJ][eE][cC][tT][sS]-[aA][pP][pP]/[mM][eE][mM][oO][rR][yY](/.*)?$")
