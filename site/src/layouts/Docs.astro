---
import { docGroups } from "../lib/docs";
import { GITHUB } from "../lib/rewrite-links.mjs";
import Base from "./Base.astro";

interface Props {
  title: string;
  current?: string;
  source?: string;
}
const { title, current, source } = Astro.props;
const base = import.meta.env.BASE_URL;
const groups = await docGroups();
---

<Base title={title} section="docs">
  <div class="wrap docs">
    <aside class="side">
      <details open>
        <summary>All documents</summary>
        <nav aria-label="Documents">
          {
            groups.map((g) => (
              <section>
                <h2>{g.title}</h2>
                <ul>
                  {g.docs.map((d) => (
                    <li>
                      <a href={`${base}docs/${d.id}/`} aria-current={d.id === current ? "page" : undefined}>
                        {d.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </nav>
      </details>
    </aside>
    <article class="prose">
      <slot />
      {
        source && (
          <p class="muted edit">
            Source: <a href={`${GITHUB}/blob/main/${source}`}>{source}</a>
          </p>
        )
      }
    </article>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 48px;
    padding-top: 32px;
  }
  .side {
    font-size: 14px;
    position: sticky;
    top: 72px;
    align-self: start;
    max-height: calc(100vh - 88px);
    overflow-y: auto;
  }
  .side summary {
    display: none;
  }
  .side h2 {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 20px 0 6px;
  }
  .side section:first-child h2 {
    margin-top: 0;
  }
  .side ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .side li a {
    display: block;
    padding: 3px 8px;
    border-radius: 6px;
    color: var(--fg);
    text-decoration: none;
  }
  .side li a:hover {
    background: var(--bg-soft);
  }
  .side li a[aria-current="page"] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .edit {
    margin-top: 48px;
    font-size: 14px;
  }
  @media (max-width: 820px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding-top: 16px;
    }
    .side {
      position: static;
      max-height: none;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 10px 14px;
    }
    .side summary {
      display: list-item;
      cursor: pointer;
      font-weight: 600;
    }
  }
</style>
